
create table if not exists gold.daily_sales_summary as
	select 
		date_trunc('day', oe.order_date) as sales_date,
		cc.country,
		cc.acquisition_channel as sales_channel,
		count(oe.order_id) as orders_count,
		count(oe.order_id) filter (where oe.payment_status = 'paid') as paid_orders_count,
		count(oe.order_id) filter (where oe.payment_status = 'failed') as cancelled_orders_count,
		round(sum(oie.gross_value) filter (where oe.payment_status = 'paid'), 2) as gross_revenue,
		sum(oie.discount_value) as discount_value,
		round(sum(oie.net_value) filter (where oe.payment_status = 'paid'), 2) as net_revenue
	from silver.customers_clean cc
	join silver.orders_enriched oe
	on cc.customer_id = oe.customer_id
	join silver.order_items_enriched oie
	on oe.order_id = oie.order_id
	group by sales_date, cc.country, cc.acquisition_channel;

create table if not exists gold.customer_analytics as 
with customer_total_net_revenue as (
	select 
		cc.customer_id,
		sum(oie.net_value) as total_net_revenue
	from silver.customers_clean cc
	join silver.orders_enriched oe
	on cc.customer_id = oe.customer_id
	join silver.order_items_enriched oie
	on oe.order_id = oie.order_id
	where oe.payment_status = 'paid'
	group by cc.customer_id
)
	select 
		cc.customer_id,
		cc.customer_name,
		cc.country,
		max(oe.order_date) as last_order_date,
		min(oe.order_date) as first_order_date,
		count(oe.order_id) as orders_count,
		coalesce(sum(oie.net_value) filter (where payment_status = 'paid'), 0) as total_net_revenue,
		round(avg(oie.net_value) filter (where payment_status = 'paid'), 2) as average_order_value,
		dense_rank() over ( 
			order by coalesce(sum(oie.net_value) filter (where payment_status = 'paid'), 0) desc
		) as customer_lifetime_rank
	from silver.customers_clean cc
	left join silver.orders_enriched oe
	on cc.customer_id = oe.customer_id
	left join silver.order_items_enriched oie
	on oe.order_id = oie.order_id 
	group by cc.customer_id, cc.customer_name, cc.country;

create table if not exists gold.product_performance_monthly as 
	with product_performence_by_month as (
		select 
			date_trunc('month', oe.order_date) as sales_month,
			oie.category,
			oie.product_id,
			oie.product_name,
			sum(oie.quantity) as units_sold,
			sum(gross_value) as gross_revenue,
			sum(net_value) as net_revenue
		from silver.orders_enriched oe
		join silver.order_items_enriched oie
		on oie.order_id = oe.order_id
		where oe.payment_status = 'paid'
		group by sales_month, oie.product_id, oie.product_name, oie.category
	)
	select
		ppbm.sales_month,
		ppbm.category,
		ppbm.product_id,
		ppbm.product_name,
		ppbm.units_sold,
		ppbm.gross_revenue,
		ppbm.net_revenue,
		rank() over (
			partition by sales_month, category
			order by net_revenue desc
		) as category_rank_by_revenue
	from product_performence_by_month ppbm;
